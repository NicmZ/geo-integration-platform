# GEO Integration Platform 后端环境变量样例
# 复制为 .env 后按需修改；留空的 API Key 对应平台自动走确定性 mock

DATABASE_URL=sqlite:///./geo_platform.db
# DATABASE_URL=mysql+pymysql://geo:geo123@127.0.0.1:3306/geo_platform?charset=utf8mb4

SECRET_KEY=please-change-me
TOKEN_EXPIRE_DAYS=7

# CPU 调度器：local（单机线程池）| slurm（超算 sbatch）
EXECUTOR=local
CPU_CONCURRENCY=4
TENANT_MAX_CONCURRENT=2
# REDIS_URL=redis://127.0.0.1:6379/0

# Slurm（超算模式）
SLURM_PARTITION=cpu
SLURM_ACCOUNT=
SLURM_WORKDIR=./slurm_jobs
SLURM_PYTHON=python

# 支付沙箱：true 时创建订单自动确认到账
PAYMENT_SANDBOX=true
REGISTER_GIFT_BALANCE=100

# Partner 兼容层密钥
PARTNER_KEY=pk-geo-local-partner

# AI 引擎 API Key（缺省走确定性 mock，开箱即跑）
ENGINE_MOCK=false
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
ERNIE_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
HUNYUAN_API_KEY=
METASO_API_KEY=

# 全渠道发布 webhook（可选）
PUBLISH_WEBHOOK_BASE=
